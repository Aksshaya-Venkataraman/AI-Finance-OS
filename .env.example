# Run `python3 scripts/generate_env.py` to create .env with random secrets.
# This file documents the variables only - it contains no real values.

# --- Docker Compose deployment ---
DOMAIN=localhost
CORS_ORIGINS=
POSTGRES_SUPERUSER_PASSWORD=
APP_DB_USER=ai_finance
APP_DB_PASSWORD=
APP_DB_NAME=ai_finance
REDIS_PASSWORD=

# --- Application ---
# >= 32 random characters. Rotating it signs every user out.
SECRET_KEY=
# Local development only (docker compose builds this from the values above):
# DATABASE_URL=postgresql+psycopg://ai_finance:<password>@localhost:5432/ai_finance
ACCESS_TOKEN_EXPIRE_MINUTES=30
ENVIRONMENT=production
ENABLE_DOCS=false

# --- Assistant (optional) ---
# "none" = agents + deterministic summary (no data leaves the server).
# "anthropic" = Claude writes the answer from the agents' computed facts.
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# --- Password reset emails ---
FRONTEND_URL=https://localhost
EMAIL_BACKEND=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@localhost
